#include "hgimg4.as"

; ネトロシェーダー：水緑色／オレンジの色選択グロー
; このファイルは Shift-JIS (CP932) で保存する。
; Space: 背景 OFF→マス目→一枚絵 / E: 効果の切替 / P: 明滅 / Esc: 終了
; Windowsのデスクトップ解像度から80%の表示領域を確保。
; 取得非対応環境ではランタイムの初期画面サイズを使う。
view_width=ginfo_dispx : view_height=ginfo_dispy
if (view_width>0)&(view_height>0) {
    view_width=view_width*4/5 : view_height=view_height*4/5
} else {
    view_width=ginfo_sx : view_height=ginfo_sy
}
if view_width<1 : view_width=640
if view_height<1 : view_height=360
screen 0,view_width,view_height
view_width=ginfo_sx : view_height=ginfo_sy
title "ネトロシェーダー - Space: OFF/Grid/City / E: Effect / P: Pulse / Esc: exit"

; 内部解像度。実際のゲームのドット解像度に合わせる。
sw=320 : sh=180
shown_bloom_level=0
bloom_level=5         ; ブルーム強度1～10。上下キーでも変更可能。
mint_gain=0.85
orange_gain=0.85
spread_gain=0.28       ; 隣接1ドットの膨張強度
halo_gain=0.75         ; 周囲2ドットまでのにじみ強度
enabled=1
background_mode=0
e_prev=0
p_prev=0
pulse_mode=0          ; Pキーで明滅ON/OFF（初期状態OFF）
pulse_period_ms=2400.0 ; 明滅の周期（ミリ秒、0より大きくする）
pulse_min=0.15        ; 基準発光強度に対する最小倍率
pulse_max=1.35        ; 基準発光強度に対する最大倍率
pulse_phase=0.0
trail_half_ms=180.0    ; 残像の半減時間。大きいほど長い尾になる。
trail_gain=0.70        ; 残像の最終加算強度
red_gain=0.90
green_gain=0.80

; 背景画像は起動時に一度だけ読み込む。
celload "res/cyberpunk_city.png",5
gsel 5
bg_width=ginfo_sx : bg_height=ginfo_sy
gpusershader "res/shaders/neoretro.vert","res/shaders/neoretro.frag",""
buffer 1,sw,sh,screen_offscreen+screen_usergcopy
gpgetmat glow_mat,1,GPGETMAT_OPT_SCRMAT
; 短辺540pxで1サンプル間隔3px、外周半径6pxを基準とする。
; 縦横で同じ表示ピクセル幅になるようUVへ変換。
view_short=view_width
if view_height<view_short : view_short=view_height
bloom_step_px=double(view_short)/180.0
gpmatprm1 glow_mat,"u_stepX",bloom_step_px/view_width
gpmatprm1 glow_mat,"u_stepY",bloom_step_px/view_height
gpmatprm1 glow_mat,"u_spread",spread_gain
gpmatprm1 glow_mat,"u_halo",halo_gain
buffer 2,sw,sh,screen_offscreen
; 残像は別の2枚を交互に使用。同じ画像への読み書きを避ける。
gpusershader "res/shaders/neoretro.vert","res/shaders/trail_decay.frag",""
buffer 3,sw,sh,screen_offscreen+screen_usergcopy
gpgetmat trail_mat3,3,GPGETMAT_OPT_SCRMAT
buffer 4,sw,sh,screen_offscreen+screen_usergcopy
gpgetmat trail_mat4,4,GPGETMAT_OPT_SCRMAT
trail_prev=3 : trail_next=4
gosub *clear_trails
gpmatprm1 glow_mat,"u_redGain",red_gain
gpmatprm1 glow_mat,"u_greenGain",green_gain
gpmatprm1 glow_mat,"u_trailOnly",0.0
getreq last_ms,SYSREQ_TIMER
frame=0

*main
    gosub *read_input
    gosub *update_effects
    gosub *draw_scene
    gosub *update_trails
    gosub *compose_effects
    gosub *present_frame
    frame++
    await 16
    goto *main

*read_input
stick key
if key&128 : end
if key&2 : bloom_level++
if key&8 : bloom_level--
; stickの標準動作は押した瞬間のみ。長押しで反転を繰り返さない。
if key&16 {
    background_mode=(background_mode+1)\3
    ; 背景の赤・緑が次のモードに残らないよう履歴を消去。
    gosub *clear_trails
}
getkey e_now,69
if (e_now=1)&(e_prev=0) {
    enabled=1-enabled
    gosub *clear_trails
}
e_prev=e_now
getkey p_now,80
if (p_now=1)&(p_prev=0) : pulse_mode=1-pulse_mode
p_prev=p_now
gpmatprm1 glow_mat,"u_enabled",double(enabled)
return

*update_effects
if bloom_level<1 : bloom_level=1
if bloom_level>10 : bloom_level=10
bloom_scale=double(bloom_level)/5.0
; タイトル更新は強度変更時だけ。描画先をメイン画面へ戻す。
if bloom_level!=shown_bloom_level {
    gsel 0
    title "ネトロシェーダー - Bloom "+bloom_level+"/10 [Up/Down] / Space: BG / E: Effect / P: Pulse"
    shown_bloom_level=bloom_level
}
; 時間基準の減衰。長い停止後は尾も消える。
getreq now_ms,SYSREQ_TIMER
delta_ms=now_ms-last_ms : last_ms=now_ms
if delta_ms<0 : delta_ms=16
; 発光成分だけを実時間で明滅。元画像と赤・緑の残像倍率は維持。
mint_current=mint_gain : orange_current=orange_gain
if pulse_mode & enabled {
    if pulse_period_ms<1.0 : pulse_period_ms=1.0
    pulse_phase+=6.28318530718*double(delta_ms)/pulse_period_ms
    pulse_phase-=double(int(pulse_phase/6.28318530718))*6.28318530718
    mint_wave=0.5+0.5*sin(pulse_phase)
    orange_wave=0.5+0.5*sin(pulse_phase+1.57079632679)
    mint_current=mint_gain*(pulse_min+(pulse_max-pulse_min)*mint_wave)
    orange_current=orange_gain*(pulse_min+(pulse_max-pulse_min)*orange_wave)
}
gpmatprm1 glow_mat,"u_mintGain",mint_current*bloom_scale
gpmatprm1 glow_mat,"u_orangeGain",orange_current*bloom_scale
return

*draw_scene
; 1: ここにゲーム画面全体を描画する。
gsel 1
redraw 0
color 0,0,0 : boxf
if background_mode=1 {
color 10,12,24 : boxf
color 25,28,44
repeat (sw+15)/16
    xx=cnt*16
    line xx,0,xx,sh-1
loop
repeat (sh+15)/16
    yy=cnt*16
    line 0,yy,sw-1,yy
loop
}
if background_mode=2 {
    gfilter 0 : gmode 0 : pos 0,0
    gzoom sw,sh,5,0,0,bg_width,bg_height
}
; 非発光色も並べ、色選択を確認する。
color 64,255,192 : boxf 35,38,76,66
color 255,128,40 : boxf 105,38,146,66
color 160,80,220 : boxf 175,38,216,66
color 190,190,190 : boxf 245,38,286,66
repeat 28
    xx=24+cnt*10
    yy=112+int(sin(double(cnt)*0.5+double(frame)*0.04)*18.0)
    color 64,255,192
    if cnt\2 : color 255,128,40
    boxf xx,yy,xx+2,yy+2
loop
; 赤と緑の移動するランプ。実際に通過した位置に尾を残す。
rx=160+int(sin(double(frame)*0.023)*110.0)
ry=85+int(cos(double(frame)*0.031)*38.0)
color 255,22,12 : boxf rx,ry,rx+4,ry+2
gx=160+int(sin(double(frame)*0.019+2.0)*105.0)
gy=90+int(cos(double(frame)*0.027+1.0)*40.0)
color 20,255,35 : boxf gx,gy,gx+4,gy+2
; 左右非対称の目印（上下反転の確認にも使える）。
color 230,230,240 : boxf 4,4,9,9
redraw 1
return

*update_trails
; 効果OFF時は履歴処理を省略。切替時に両方の履歴を消去済み。
if enabled=0 : return
if trail_half_ms<1.0 : trail_half_ms=1.0
decay=expf(-0.69314718*double(delta_ms)/trail_half_ms)
floor_loss=double(delta_ms)/16.6667/255.0
prev_mat=trail_mat3
if trail_prev=4 : prev_mat=trail_mat4
gpmatprm1 prev_mat,"u_decay",decay
gpmatprm1 prev_mat,"u_floor",floor_loss
gsel trail_next
redraw 0
gfilter 0 : gmode 0 : pos 0,0
color 0,0,0 : boxf
celput trail_prev
gpmatprm1 glow_mat,"u_trailOnly",1.0
gmode 5,,,256 : pos 0,0
celput 1
redraw 1
gpmatprm1 glow_mat,"u_trailOnly",0.0
swap_id=trail_prev : trail_prev=trail_next : trail_next=swap_id
return

*compose_effects
; 2: 低解像度で色選択・膨張・加算を処理する。
gsel 2
redraw 0
gfilter 0
gmode 0 : pos 0,0
celput 1
; 残像を元のグロー処理済み画面へ加算。
if enabled {
    display_mat=trail_mat3
    if trail_prev=4 : display_mat=trail_mat4
    gpmatprm1 display_mat,"u_decay",1.0
    gpmatprm1 display_mat,"u_floor",0.0
    gmode 5,,,int(trail_gain*256.0) : pos 0,0
    celput trail_prev
}
redraw 1
return

*present_frame
; 3: 処理済み画像をニアレストで画面全体へ拡大。
gsel 0
redraw 0
gfilter 0
gmode 0 : pos 0,0
gzoom view_width,view_height,2,0,0,sw,sh
redraw 1
return

*clear_trails
; 初期化・背景切替・効果切替で共用する。
gsel 3 : redraw 0 : color 0,0,0 : boxf : redraw 1
gsel 4 : redraw 0 : color 0,0,0 : boxf : redraw 1
return